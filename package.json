{
  "name": "r-code",
  "productName": "R-Code",
  "version": "0.1.0",
  "description": "One elegant home for Claude Code, Codex and Pi.",
  "author": "Ryan (Rybib)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --mac",
    "dist:dmg": "electron-vite build && electron-builder --mac dmg"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.314",
    "@anthropic-ai/sdk": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "diff": "^8.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@iconify-json/vscode-icons": "^1.2.94",
    "@iconify/react": "^6.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "kokoro-js": "^1.2.1",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "zustand": "^5.0.16"
  },
  "build": {
    "appId": "dev.rcode.app",
    "productName": "R-Code",
    "copyright": "© 2026 Ryan Dunn",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        "dir",
        "dmg"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "R-Code uses the microphone for on-device Whisper dictation.",
        "NSAppleEventsUsageDescription": "R-Code opens Terminal for agent sign-in."
      }
    },
    "dmg": {
      "title": "R-Code",
      "writeUpdateInfo": false
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rybib/R-Code.git"
  }
}
